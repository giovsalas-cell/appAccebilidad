rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function autenticado() {
      return request.auth != null;
    }

    function esAdmin() {
      return autenticado() &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'admin';
    }

    match /usuarios/{uid} {
      // Cada persona lee su propio perfil; el administrador puede leer y listar todos.
      allow get: if autenticado() && (request.auth.uid == uid || esAdmin());
      allow list: if esAdmin();

      // El registro solo puede crear el propio perfil y siempre con rol "usuario".
      allow create: if autenticado() && request.auth.uid == uid && request.resource.data.rol == 'usuario';

      // Un usuario edita su perfil sin cambiar su rol; el admin puede editar cualquiera.
      allow update: if autenticado() &&
        ((request.auth.uid == uid && request.resource.data.rol == resource.data.rol) || esAdmin());

      // Solo el admin elimina perfiles y nunca el propio.
      allow delete: if esAdmin() && request.auth.uid != uid;

      // Mensajes y ubicación: solo su dueño.
      match /{subcoleccion=**} {
        allow read, write: if autenticado() && request.auth.uid == uid;
      }
    }
  }
}
